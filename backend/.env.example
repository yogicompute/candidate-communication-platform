# Local development defaults. Copy to .env (never commit .env).

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to submit the Django admin login form (production HTTPS URLs).
CSRF_TRUSTED_ORIGINS=

# Optional PostgreSQL. SQLite (backend/db.sqlite3) is used while POSTGRES_DB is empty.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dummy provider (a local simulation, not a real SMS service).
# Shared by Django and `python -m providers.dummy_server`. Use your own random values outside local dev.
DUMMY_PROVIDER_URL=http://127.0.0.1:8100
DUMMY_PROVIDER_PORT=8100
DUMMY_PROVIDER_API_KEY=local-dummy-provider-key
PROVIDER_WEBHOOK_SECRET=local-webhook-secret-change-me
PROVIDER_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhooks/provider/
PROVIDER_TIMEOUT_SECONDS=5