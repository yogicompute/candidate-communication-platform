# Local development defaults. Copy to .env (never commit .env).

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to submit the Django admin login form (production HTTPS URLs).
CSRF_TRUSTED_ORIGINS=

# Optional PostgreSQL. SQLite (backend/db.sqlite3) is used while POSTGRES_DB is empty.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432